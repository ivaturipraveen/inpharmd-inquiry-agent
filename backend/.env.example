# Copy to .env and fill in. See CLAUDE.md for the full architecture writeup.

# Database
DATABASE_URL=

# CORS / frontend
CORS_ORIGINS=http://localhost:5173
# Base URL of the deployed frontend, used for clickable links back into the app.
APP_BASE_URL=

# InpharmD platform (staging/production) — REQUIRED, no code fallback.
# Never copy a staging value into production or vice versa.
INPHARMD_API_BASE_URL=
INPHARMD_LIST_TTL_SECONDS=300
INPHARMD_DETAIL_TTL_SECONDS=600

# ElevenLabs — outbound voice calls
ELEVENLABS_API_KEY=
ELEVENLABS_INQUIRY_AGENT_ID=
ELEVENLABS_INQUIRY_PHONE_NUMBER_ID=
# Shared secrets below: generate each with `openssl rand -hex 32`.
ELEVENLABS_WEBHOOK_SECRET=
AGENT_TOOLS_SECRET=
TRANSFER_PHARMACIST_NAME=Leah
TRANSFER_PHARMACIST_PHONE=+15134906650
CALL_PLACE_TIMEOUT_SECONDS=30
CALL_POLL_TIMEOUT_SECONDS=20

# SendGrid — outbound email + Inbound Parse webhook
SENDGRID_API_KEY=
EMAIL_FROM=druginfo@inpharmd.com
EMAIL_FROM_NAME=InpharmD Medical Information
# Path-token secret for /api/email/inbound/{token}; generate with openssl rand -hex 32.
EMAIL_INBOUND_SECRET=
SENDGRID_SEND_TIMEOUT_SECONDS=30

# IMAP — polls EMAIL_FROM's mailbox for manufacturer replies
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT_SECONDS=30
IMAP_POLL_SECONDS=60

# Microsoft Graph — alternate mailbox-polling path
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_TOKEN_TIMEOUT_SECONDS=15
GRAPH_LIST_ATTACHMENTS_TIMEOUT_SECONDS=30
GRAPH_DOWNLOAD_ATTACHMENT_TIMEOUT_SECONDS=60
GRAPH_MARK_READ_TIMEOUT_SECONDS=10
GRAPH_LIST_MESSAGES_TIMEOUT_SECONDS=20

# Legacy InpharmD platform response POST
LEGACY_RESPONSE_API_KEY=
LEGACY_RESPONSE_TIMEOUT_SECONDS=15
LEGACY_RESPONSE_MAX_RETRIES=2

# OpenAI — transcript/PDF answer extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIME_SENSITIVE_TIMEOUT_SECONDS=15

# AWS S3 / R2 — PDF + Excel storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_PREFIX=inquiry-pdfs/
AWS_S3_URL_TTL_SECONDS=604800

# Slack — answer-card notifications
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_TIMEOUT_SECONDS=10

# DailyMed — NDC enrichment
DAILYMED_REQUEST_TIMEOUT_SECONDS=15

# Scheduler tick intervals / thresholds — all optional, defaults shown.
INQUIRY_RETRY_TICK_SECONDS=60
EMAIL_SCHEDULE_DELAY_MINUTES=30
EMAIL_SEND_TICK_SECONDS=60
NO_RESPONSE_TICK_SECONDS=1800
NO_RESPONSE_ALERT_HOURS=48
CALL_RECONCILE_TICK_SECONDS=300
CALL_STUCK_THRESHOLD_MINUTES=10
CALL_RECONCILE_MAX_AGE_HOURS=24
CALL_RECONCILE_BATCH_SIZE=25
CALL_OUTCOME_UNKNOWN_PARK_MINUTES=10
CALL_NEVER_ACCEPTED_TIMEOUT_MINUTES=45

# Web Form automation — fill-only PREPARE for unregistered manufacturers; never submits.
WEBFORM_GENERIC_ENGINE_ENABLED=true

# Local dev / seeding
SEED_EXCEL_PATH=
