DATABASE_URL=postgresql://user:password@host:5432/dbname
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ElevenLabs voice agent (for inquiry fallback calls) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Optional: dedicated IDs for the MI inquiry agent (otherwise reuses the above)
ELEVENLABS_INQUIRY_AGENT_ID=
ELEVENLABS_INQUIRY_PHONE_NUMBER_ID=

# Optional: shared secret for the ElevenLabs post-call webhook
ELEVENLABS_WEBHOOK_SECRET=

# Shared secret the voice agent sends in X-Agent-Secret when calling
# our /api/agent-tools/* endpoints during a live call
AGENT_TOOLS_SECRET=
